{
  "name": "the-crease-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@the-crease/web",
    "dev:web": "npm run dev --workspace=@the-crease/web",
    "dev:api": "npm run start:dev --workspace=@the-crease/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run prisma:generate --workspace=@the-crease/api",
    "db:migrate": "npm run prisma:migrate --workspace=@the-crease/api",
    "db:studio": "npm run prisma:studio --workspace=@the-crease/api"
  },
  "engines": { "node": ">=22.0.0", "npm": ">=10.0.0" }
}
