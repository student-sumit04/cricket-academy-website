generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COACH
  STUDENT
  PARENT
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum FeeStatus {
  DRAFT
  DUE
  PARTIALLY_PAID
  PAID
  WAIVED
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TournamentStatus {
  DRAFT
  OPEN
  CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WITHDRAWN
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL_BOOKED
  CONVERTED
  CLOSED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  roles        UserRole[]
  student      Student?
  parent       Parent?
  coach        Coach?
  sessions     AuthSession[]
  auditEvents  AuditLog[] @relation("ActorAuditLogs")

  @@index([isActive])
}

model UserRole {
  userId String
  role   Role
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, role])
  @@index([role])
}

model AuthSession {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Student {
  id          String   @id @default(cuid())
  userId      String   @unique
  dateOfBirth DateTime @db.Date
  gender      String?
  medicalNotesEncrypted String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)
  guardians   StudentGuardian[]
  enrollments Enrollment[]
  fees        Fee[]
  payments    Payment[]
  performances Performance[]
  registrations TournamentRegistration[]
}

model Parent {
  id        String @id @default(cuid())
  userId    String @unique
  occupation String?
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)
  students  StudentGuardian[]
}

model StudentGuardian {
  studentId   String
  parentId    String
  relationship String
  isPrimary   Boolean @default(false)
  canPickup   Boolean @default(true)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  @@id([studentId, parentId])
  @@index([parentId])
}

model Coach {
  id             String @id @default(cuid())
  userId         String @unique
  bio            String?
  experienceYears Int @default(0)
  specialties    String[]
  certification  String?
  user            User @relation(fields: [userId], references: [id], onDelete: Restrict)
  batches         Batch[]
  performances    Performance[]
}

model Program {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String
  minAge      Int?
  maxAge      Int?
  isPublished Boolean @default(false)
  batches     Batch[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Batch {
  id          String @id @default(cuid())
  programId   String
  coachId     String
  name        String
  capacity    Int
  startDate   DateTime @db.Date
  endDate     DateTime? @db.Date
  schedule    Json
  location    String
  isActive    Boolean @default(true)
  program     Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  coach       Coach @relation(fields: [coachId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([programId, name, startDate])
  @@index([coachId, isActive])
}

model Enrollment {
  id        String @id @default(cuid())
  studentId String
  batchId   String
  status    EnrollmentStatus @default(PENDING)
  joinedAt  DateTime @default(now())
  endedAt   DateTime?
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  batch     Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  @@unique([studentId, batchId])
  @@index([batchId, status])
  @@index([studentId, status])
}

model Fee {
  id          String @id @default(cuid())
  studentId   String
  title       String
  amountPaise Int
  currency    String @default("INR")
  dueDate     DateTime @db.Date
  status      FeeStatus @default(DRAFT)
  notes       String?
  student     Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  payments    Payment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([studentId, status])
  @@index([status, dueDate])
}

model Payment {
  id                String @id @default(cuid())
  feeId             String
  studentId         String
  amountPaise       Int
  currency          String @default("INR")
  status            PaymentStatus @default(CREATED)
  provider          String @default("RAZORPAY")
  providerOrderId   String @unique
  providerPaymentId String? @unique
  receiptNumber     String? @unique
  capturedAt        DateTime?
  failureReason     String?
  metadata          Json?
  fee               Fee @relation(fields: [feeId], references: [id], onDelete: Restrict)
  student           Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  events            PaymentEvent[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([studentId, createdAt])
  @@index([feeId, status])
}

model PaymentEvent {
  id              String @id @default(cuid())
  paymentId       String?
  providerEventId String @unique
  eventType       String
  signature       String
  payload         Json
  processedAt     DateTime?
  error           String?
  createdAt       DateTime @default(now())
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  @@index([processedAt, createdAt])
}

model Performance {
  id        String @id @default(cuid())
  studentId String
  coachId   String
  recordedAt DateTime @default(now())
  category  String
  metrics   Json
  score     Int?
  notes     String?
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  coach     Coach @relation(fields: [coachId], references: [id], onDelete: Restrict)
  @@index([studentId, recordedAt])
  @@index([coachId, recordedAt])
}

model Tournament {
  id          String @id @default(cuid())
  name        String
  description String?
  venue       String
  startsAt    DateTime
  endsAt      DateTime
  registrationClosesAt DateTime?
  status      TournamentStatus @default(DRAFT)
  registrations TournamentRegistration[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, startsAt])
}

model TournamentRegistration {
  id           String @id @default(cuid())
  tournamentId String
  studentId    String
  status       RegistrationStatus @default(PENDING)
  registeredAt DateTime @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  student      Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  @@unique([tournamentId, studentId])
  @@index([studentId, status])
}

model AdmissionLead {
  id          String @id @default(cuid())
  playerName  String
  playerAge   Int
  phone       String
  email       String?
  interest    String
  source      String @default("WEBSITE")
  status      LeadStatus @default(NEW)
  consentAt   DateTime
  assignedTo  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, createdAt])
  @@index([phone])
}

model AuditLog {
  id         String @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  requestId  String
  createdAt  DateTime @default(now())
  actor      User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
